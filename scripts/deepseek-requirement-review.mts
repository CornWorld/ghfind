/** Apply reviewed corrections after JobSyncWorkflow for this exact JD snapshot.
 * These jobs remain on the hiring board. HR/finance/facility/procurement
 * qualifications cannot be evaluated by the current technical skill taxonomy.
 * Source-hash guards leave subsequently changed JDs untouched.
 */
import { writeFileSync } from "node:fs";
import { loadImport } from "./deepseek-jobs-import.mts";
import { jobInputHash } from "../src/lib/talent-match/pipeline";

const excluded = [
  ["deepseek-08d2d307-recruiting", "Recruiting expertise is not technical writing"],
  ["deepseek-08d2d307-services", "HR administration is not engineering team leadership or prompt engineering"],
  ["deepseek-2f6838b7-accounting", "Accounting and finance expertise is not engineering team leadership"],
  ["deepseek-1c7e328d-design", "Electrical and cooling facility design is not software system design"],
  ["deepseek-1c7e328d-operations", "Data center facility operations is not engineering team leadership"],
  ["deepseek-97ecb322-assets", "Inventory and asset management is not engineering team leadership"],
  ["deepseek-97ecb322-cloud", "Cloud procurement does not explicitly require AWS, GCP and Azure engineering skills"],
] as const;

export function buildReviewSql(now = Date.parse("2026-10-14T00:35:00+08:00")) {
  const { roles } = loadImport();
  const updates: { id: string; reason: string; mustHave: { id: string; level: number }[]; niceToHave: { id: string; level: number }[] }[] = excluded.map(([id, reason]) => ({ id, reason, mustHave: [] as { id: string; level: number }[], niceToHave: [] as { id: string; level: number }[] }));
  updates.push({
    id: "deepseek-1c7e328d-onsite", reason: "Keep explicit network and storage maintenance; remove inferred software testing, ETL and engineering management",
    mustHave: [{ id: "networking", level: 2 }, { id: "storage-systems", level: 2 }], niceToHave: [],
  });
  const quote = (v: string) => `'${v.replace(/'/g, "''")}'`;
  return "-- Generated by scripts/deepseek-requirement-review.mts. Apply after JobSyncWorkflow.\n\n" + updates.map((update) => {
    const role = roles.find((r) => r.id === update.id)!;
    const text = [role.title.en, ["DeepSeek Careers", role.location.en, role.employment].join(" | "), `${role.title.en}. See the official job description for responsibilities and requirements.`, role.description].join("\n\n");
    return `-- ${update.reason}\nUPDATE job_requirements\nSET requirement_json = json_set(requirement_json, '$.mustHave', json(${quote(JSON.stringify(update.mustHave))}), '$.niceToHave', json(${quote(JSON.stringify(update.niceToHave))})), updated_at = ${now}\nWHERE job_id = ${quote(update.id)} AND schema_version = 1 AND input_hash = ${quote(jobInputHash(text))};`;
  }).join("\n\n") + "\n";
}

if (import.meta.url === `file://${process.argv[1]}`) {
  writeFileSync(new URL("../migrations/0027_deepseek_requirement_review.sql", import.meta.url), buildReviewSql());
  console.log("Prepared eight source-hash-guarded requirement corrections.");
}
